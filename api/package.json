{
  "name": "maintafox-control-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "test:auth-boundaries": "pnpm run build && node scripts/auth-boundaries.integration.mjs",
    "test:license-lifecycle": "pnpm run build && node scripts/license-issuance-lifecycle.integration.mjs",
    "test:machine-revocation": "pnpm run build && node scripts/machine-revocation-lifecycle.integration.mjs",
    "test:edition-catalog": "pnpm run build && node scripts/edition-catalog-store.mjs && node scripts/edition-catalog.integration.mjs",
    "test:legacy-tenant-schema": "pnpm run build && node scripts/legacy-tenant-schema.integration.mjs",
    "test:force-update": "pnpm run build && node scripts/force-update-governance.integration.mjs",
    "test:sync-exchange-ab": "pnpm run build && node scripts/sync-exchange-ab.integration.mjs",
    "test:sync-v2": "pnpm run build && node scripts/sync-protocol-v2.integration.mjs",
    "test:tenant-isolation": "pnpm run build && node scripts/tenant-isolation.integration.mjs",
    "test:ops-metrics": "pnpm run build && node scripts/ops-metrics.integration.mjs",
    "test:backup-drill": "pnpm run build && node scripts/backup-restore-drill.integration.mjs",
    "test:backup-offsite": "pnpm run build && node scripts/backup-offsite.integration.mjs",
    "test:all": "pnpm run build && node scripts/edition-catalog-store.mjs && node scripts/edition-signer-roundtrip.mjs && node scripts/auth-boundaries.integration.mjs && node scripts/license-issuance-lifecycle.integration.mjs && node scripts/machine-revocation-lifecycle.integration.mjs && node scripts/edition-catalog.integration.mjs && node scripts/legacy-tenant-schema.integration.mjs && node scripts/force-update-governance.integration.mjs && node scripts/sprint9-observability.integration.mjs && node scripts/sync-exchange-ab.integration.mjs && node scripts/sync-protocol-v2.integration.mjs && node scripts/tenant-isolation.integration.mjs && node scripts/ops-metrics.integration.mjs",
    "migrate:sqlite-to-postgres": "node dist/tools/migrate-sqlite-to-postgres.js",
    "baseline:sprint9": "node scripts/sprint9-slo-baseline.mjs",
    "test:observability": "pnpm run build && node scripts/sprint9-observability.integration.mjs",
    "uat:sprint10": "node scripts/sprint10-uat-real-infra.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "7.5.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "16.13.0-beta.17",
    "typescript": "^5.7.0"
  }
}
