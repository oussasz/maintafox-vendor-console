# Copy to .env before: docker compose up -d --build
#
# Every variable below is REQUIRED unless marked optional: the API and docker compose
# refuse to start when one is missing (no built-in defaults for secrets).
#
# openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Ed25519 key that signs licence entitlement envelopes. Do NOT type these by hand — generate:
#   node api/scripts/generate-entitlement-signing-key.mjs --env-file .env --key-id mfx-ed25519-YYYY-MM
# The script writes both lines below and prints the PUBLIC key to embed in the desktop app
# (src-tauri/src/entitlements/trusted_keys.rs). The private key must never leave this server.
ENTITLEMENT_SIGNING_KEY_ID=replace-by-running-the-generator
ENTITLEMENT_SIGNING_PRIVATE_KEY=replace-by-running-the-generator

# First login for vendor console (only used when the users table is empty; stored hashed)
SEED_ADMIN_EMAIL=admin@maintafox.systems
SEED_ADMIN_PASSWORD=change-me-strong-password

# Browser origin(s) allowed to call the API (comma-separated)
CORS_ORIGIN=https://console.maintafox.systems

# Installed desktop app (Tauri webview) origins, comma-separated. Allowed ONLY on device routes
# (/api/v1/activation/*, /api/v1/sync/*), never on admin routes. Exact origins, no wildcard.
# Windows: http://tauri.localhost (https://tauri.localhost if useHttpsScheme); macOS/Linux: tauri://localhost
DESKTOP_APP_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost

# Must match public API URL (used when building the SPA)
VITE_ADMIN_API_BASE_URL=https://api.maintafox.systems

# Host ports for edge nginx (80 + 443 when TLS is enabled)
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# --- Postgres (all control-API data, versioned migrations in api/migrations) + TenantMedia (MinIO/S3) ---
# DATABASE_URL is required: the API refuses to start without it.
POSTGRES_USER=maintafox
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=maintafox_sync
DATABASE_URL=postgres://maintafox:replace-with-strong-postgres-password@postgres:5432/maintafox_sync

# --- Sync protocol v2 (deploy/SYNC_PROTOCOL_V2.md). All required. ---
# HMAC key for checkpoint and snapshot page tokens, >= 32 chars (e.g. `openssl rand -hex 32`).
# Rotating it invalidates every device checkpoint (devices bootstrap again with a snapshot).
SYNC_CHECKPOINT_SECRET=replace-with-64-hex-chars-from-openssl-rand-hex-32
# Log rows older than this, already passed by every active device, are compacted (1..3650).
SYNC_INGRESS_RETENTION_DAYS=90
# Stored exchange responses (idempotent replay) older than this are pruned (1..3650).
SYNC_IDEMPOTENCY_RETENTION_DAYS=14
# Retention job interval in minutes (5..1440).
SYNC_RETENTION_INTERVAL_MINUTES=60
# Encryption at rest of sensitive sync payloads (user_accounts) and stored exchange responses
# (AES-256-GCM). Base64 of 32 random bytes: `openssl rand -base64 32`. Losing it makes those stored
# values unreadable: keep it with the other secrets (it travels in the encrypted off-site .env copy).
# A subkey of it (HKDF label "maintafox/vendor-totp/v1") seals the console operators' TOTP secrets:
# rotating it also requires re-encrypting those (deploy/VENDOR_AUTH.md).
SYNC_PAYLOAD_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# Tenant isolation: rows of operator_scope_access (every cross-tenant operator/system access)
# older than this are deleted (1..3650).
OPERATOR_ACCESS_LOG_RETENTION_DAYS=365
# Optional: bearer token (>= 32 chars, `openssl rand -hex 32`) a Prometheus server uses to scrape
# GET https://api.maintafox.systems/api/v1/ops/metrics. Unset: only vendor operator tokens work.
# METRICS_SCRAPE_TOKEN=

# --- Notification email (desktop notifications sent by the server, deploy/NOTIFICATION_EMAIL.md) ---
# disabled | smtp. Required. Also turn on the edition capability "notifications.email" in the console.
EMAIL_DELIVERY_MODE=disabled
# Required only with smtp (any SMTP provider; SMTP_USER and SMTP_PASSWORD both or neither):
# SMTP_HOST=smtp.example-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=Maintafox <notifications@maintafox.systems>

MINIO_ROOT_USER=replace-with-minio-admin-user
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=replace-with-minio-admin-user
S3_SECRET_KEY=replace-with-strong-minio-password
S3_BUCKET=maintafox-tenant-media
S3_FORCE_PATH_STYLE=true
DEPLOYMENT_ENV=prod

# --- SlickPay online payments (deploy/BILLING.md) ---
# disabled | enabled. Required. With enabled, every SLICKPAY_* below is required.
# SlickPay authenticates with the PUBLIC key only (developers.slick-pay.com/authentication): the
# SlickPay SECRET key is not used by this server and must not be put here.
# Prices are not set here: the owner sets them on the console's Billing page.
SLICKPAY_MODE=disabled
# SLICKPAY_PUBLIC_KEY=replace-with-the-public-key-from-the-slickpay-dashboard
# Live: https://prodapi.slick-pay.com/api/v2   (SlickPay's sandbox: https://devapi.slick-pay.com/api/v2)
# SLICKPAY_API_BASE_URL=https://prodapi.slick-pay.com/api/v2
# Public URL of this API's webhook route (SlickPay calls it after a payment).
# SLICKPAY_WEBHOOK_URL=https://api.maintafox.systems/api/v1/webhooks/slickpay
# Page the customer returns to after paying: the website's order status page.
# SLICKPAY_RETURN_URL=https://www.maintafox.systems/checkout/result
# Per call to SlickPay (milliseconds).
# SLICKPAY_HTTP_TIMEOUT_MS=15000
# First automatic re-check of an unpaid order; doubled after each check (minutes).
# SLICKPAY_RECONCILE_INTERVAL_MINUTES=5
# An order still unpaid after this many hours is marked expired (a late payment is still honoured).
# SLICKPAY_ORDER_EXPIRY_HOURS=72
# Optional, recommended: shared secret (>= 32 chars, `openssl rand -hex 32`) with the website on
# Vercel (same value there as CONTROL_PLANE_PROXY_TOKEN). With it, public checkout / order status
# calls are rate-limited per customer; without it all website customers share one limit.
# WEBSITE_PROXY_TOKEN=

# --- Backups (deploy/BACKUP_AND_RESTORE.md). All required. ---
# Postgres forces a WAL segment into the archive at least this often (seconds) = worst-case data
# loss between nightly backups on this server. 900 = 15 minutes.
PG_WAL_ARCHIVE_TIMEOUT_SECONDS=900
# Nightly backup time (HH:MM, UTC) and the day of the month (1..28) of the automatic restore drill.
BACKUP_DAILY_AT_UTC=02:30
BACKUP_DRILL_DAY_OF_MONTH=1
# Local dumps / base backups older than this are deleted (the newest base backup is always kept).
BACKUP_LOCAL_RETENTION_DAYS=14
# Old versions of overwritten/deleted media objects are kept this many days (MinIO versioning).
MINIO_NONCURRENT_VERSION_RETENTION_DAYS=30
# Off-site copy: "disabled" (local copies only: NOT a real backup, the server's disk is a single
# point of failure) or "s3" (any S3-compatible bucket; every object is age-encrypted first).
BACKUP_OFFSITE_MODE=disabled
# Required only when BACKUP_OFFSITE_MODE=s3:
# BACKUP_OFFSITE_S3_ENDPOINT=https://s3.example-provider.com
# BACKUP_OFFSITE_S3_REGION=region-of-the-bucket
# BACKUP_OFFSITE_S3_BUCKET=bucket-name
# BACKUP_OFFSITE_S3_ACCESS_KEY=key-with-write-and-list-rights-only
# BACKUP_OFFSITE_S3_SECRET_KEY=secret
# BACKUP_OFFSITE_S3_PREFIX=maintafox-prod
# BACKUP_OFFSITE_S3_FORCE_PATH_STYLE=false
# Encryption at rest of every local backup (dumps, base backups, WAL archive), §7:
# "required" (every file age-encrypted to BACKUP_AGE_RECIPIENT; the backup and the WAL archiving
# refuse to run without it) or "disabled" (plaintext on disk). Run keygen.sh first (§7.2).
BACKUP_LOCAL_ENCRYPTION=required
# The owner's public key, written here by deploy/backup/keygen.sh (the private key is shown once,
# saved by the owner in a password manager, and never kept on this server):
# BACKUP_AGE_RECIPIENT=age1...
# Read-only SFTP pull of the encrypted backups to an on-premise machine (optional,
# deploy/backup-pull/README.md). Only with COMPOSE_FILE=docker-compose.yml:deploy/backup-pull/compose.yml
# BACKUP_PULL_PORT=2222
# BACKUP_PULL_AUTHORIZED_KEYS=/root/maintafox-backup-pull/authorized_keys
