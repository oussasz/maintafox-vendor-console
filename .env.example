# Copy to .env before: docker compose up -d --build
#
# openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# First login for vendor console (stored hashed in SQLite)
SEED_ADMIN_EMAIL=admin@maintafox.systems
SEED_ADMIN_PASSWORD=change-me-strong-password

# Browser origin(s) allowed to call the API (comma-separated)
CORS_ORIGIN=http://console.maintafox.systems

# Must match public API URL (used when building the SPA)
VITE_ADMIN_API_BASE_URL=http://api.maintafox.systems

# Host port 80 must be free for edge nginx
EDGE_HTTP_PORT=80
